{
	"pages": [
		{
			"path": "pages/splash",
			"style": {
				"app-plus": {
					"titleNView": false,
					"bounce": "none"
				}
			}
		},
		{
			"path": "pages/discovering",
			"style": {
				"navigationBarTitleText": "Discovering",
				"pullToRefresh": {
					"support": true,
					"style": "circle"
				}
			}
		},
		{
			"path": "pages/home",
			"style": {
				"navigationBarTitleText": "Home",
				"pullToRefresh": {
					"support": true,
					"style": "circle"
				}
			}
		},
		{
			"path": "pages/mine",
			"style": {
				"navigationBarTitleText": "Mine",
				"pullToRefresh": {
					"support": true,
					"style": "circle"
				}
			}
		}
	],
	"tabBar": {
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/home",
				"text": "Home"
			},
			{
				"pagePath": "pages/mine",
				"text": "Mine"
			}
		]
	},
	"globalStyle": {
		"navigationBarTitleText": "uni-app"
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uv-(.*)": "@climblee/uv-ui/components/uv-$1/uv-$1.vue"
		}
	}
}